                if (streamStudents.length === 0) { html +=
                        `<tr><td>${stream}</td><td colspan="4" style="color:#94a3b8;">No students</td></tr>`; return; }
                const avgStream = streamStudents.reduce((a, b) => a + avg(b), 0) / streamStudents.length;
                const passCount = streamStudents.filter(s => avg(s) >= 50).length;
                const passRate = (passCount / streamStudents.length * 100).toFixed(1);
                const topStudent = [...streamStudents].sort((a, b) => avg(b) - avg(a))[0];
                html +=
                    `<tr><td><strong>${stream}</strong></td><td>${streamStudents.length}</td><td><strong>${avgStream.toFixed(1)}%</strong></td><td>${passRate}%</td><td>${topStudent ? escapeHtml(topStudent.name) + ' (' + avg(topStudent).toFixed(1) + '%)' : 'N/A'}</td></tr>`;
