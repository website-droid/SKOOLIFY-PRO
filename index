        function loadExamMarks() {
            try {
                const examId = document.getElementById('examMarkExam').value;
                const grade = document.getElementById('examMarkClass').value;
                const stream = document.getElementById('examMarkStream').value;
                const container = document.getElementById('examMarksContainer');
                if (!examId) { container.innerHTML =
                        '<p style="color:#94a3b8;text-align:center;padding:20px;">Select an exam to enter marks.</p>'; return; }
                const exam = exams.find(e => e.id == examId);
                if (!exam) { container.innerHTML =
                    '<p style="color:#dc2626;text-align:center;padding:20px;">Exam not found.</p>'; return; }
                const filtered = students.filter(s => s.class === grade && s.stream === stream);
                if (filtered.length === 0) { container.innerHTML =
                        '<p style="color:#94a3b8;text-align:center;padding:20px;">No students in this class/stream.</p>'; return; }
                let html =
                    `<h4>${escapeHtml(exam.name)} - ${grade} ${stream}</h4><div class="table-wrapper"><table class="data-table"><thead><tr><th>Student</th>`;
                exam.subjects.forEach(sub => { html += `<th>${sub}</th>`; });
                html += `<th>Total</th><th>Avg</th></tr></thead><tbody>`;
                filtered.forEach(s => {
                    html += `<tr><td><strong>${escapeHtml(s.name)}</strong></td>`;
                    let total = 0;
                    exam.subjects.forEach(sub => {
                        const existing = examMarks.find(m => m.examId == examId && m.studentId === s.id &&
                            m.subject === sub);
                        const val = existing ? existing.marks : '';
                        html +=
                            `<td><input type="number" class="exam-mark-input" data-exam="${examId}" data-student="${s.id}" data-sub="${sub}" value="${val}" min="0" max="100" step="1" style="width:60px;padding:4px;border-radius:8px;border:1px solid #ddd;"></td>`;
                        if (val) total += parseFloat(val);
                    });
                    const avgVal = exam.subjects.length ? (total / exam.subjects.length).toFixed(1) : 0;
                    html +=
                        `<td><strong>${total}</strong></td><td><strong>${avgVal}%</strong></td></tr>`;
                });
                html += `</tbody></table></div>
                        <div style="margin-top:10px;"><button class="action-btn warning" onclick="window.saveExamMarks()">💾 Save Exam Marks</button></div>`;
                container.innerHTML = html;
                document.querySelectorAll('.exam-mark-input').forEach(inp => {
                    inp.removeEventListener('change', handleExamMarkChange);
                    inp.addEventListener('change', handleExamMarkChange);
                });
            } catch (e) { console.error("Load exam marks error:", e);
                showPermissionError('examMarksContainer', loadExamMarks); }
        }

        async function handleExamMarkChange() {
            try {
                const examId = parseInt(this.dataset.exam);
                const studentId = parseInt(this.dataset.student);
                const subject = this.dataset.sub;
                const val = Math.min(100, Math.max(0, parseInt(this.value) || 0));
                const existing = examMarks.findIndex(m => m.examId == examId && m.studentId === studentId && m
                    .subject === subject);
                if (existing >= 0) {
                    examMarks[existing].marks = val;
                } else {
                    examMarks.push({ examId, studentId, subject, marks: val });
                }
                await saveToFirebase();
                const row = this.closest('tr');
                let total = 0;
                row.querySelectorAll('.exam-mark-input').forEach(inp => {
                    const v = parseInt(inp.value) || 0;
                    total += v;
                });
                const cells = row.cells;
                const avg = (total / (cells.length - 2)).toFixed(1);
                cells[cells.length - 2].innerHTML = `<strong>${total}</strong>`;
                cells[cells.length - 1].innerHTML = `<strong>${avg}%</strong>`;
            } catch (e) { console.error("Handle exam mark change error:", e); }
        }

