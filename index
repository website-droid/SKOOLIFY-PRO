            if (outstanding.length === 0) { showToast('🎉 No outstanding fees! All students are paid.', false); return; }
            let msg = `📢 FEE REMINDER\n\nDear Parent,\nKindly clear the outstanding school fees for the following students:\n\n`;
            outstanding.forEach(s => {
                const totalFee = feeStructures.reduce((sum, f) => sum + f.amount, 0);
                const paid = payments.filter(p => p.studentId === s.id).reduce((sum, p) => sum + p.amount, 0);
                const balance = totalFee - paid;
                msg += `• ${s.name} (${s.class}): Balance KSh ${balance.toLocaleString()}\n`;
            });
