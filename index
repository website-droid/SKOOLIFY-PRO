                let html =
                    `<h4 style="margin-bottom:15px;">Subject Analysis - ${grade}</h4><div class="table-wrapper"><table class="data-table"><thead><tr><th>Subject</th><th>Class Average</th><th>Points</th><th>Level</th><th>Performance</th></tr></thead><tbody>`;
                const gradeStudents = students.filter(s => s.class === grade);
                subs.forEach(sub => {
                    let totalMarks = 0,
                        count = 0;
                    gradeStudents.forEach(s => {
                        const mark = getMark(s, sub);
                        if (mark > 0) { totalMarks += mark;
                            count++; }
                    });
                    const avgSub = count ? totalMarks / count : 0;
                    const level = getPerformanceLevel(avgSub);
                    const performance = level.code === "EE1" || level.code === "EE2" ? "Strong" : level.code ===
                        "ME1" || level.code === "ME2" ? "Good" : level.code === "AE1" || level.code ===
                        "AE2" ? "Needs Improvement" : "Weak";
                    html +=
                        `<tr><td><strong>${sub}</strong></td><td><strong>${avgSub.toFixed(1)}%</strong></td><td><strong>${level.points}</strong></td><td><span class="grade-badge" style="background:${level.color};">${level.code}</span></td><td>${performance}</td></tr>`;
                });
                html += `</tbody></table></div>`;
                container.innerHTML = html;
            } catch (e) { console.error("showSubjectAnalysis error:", e);
                document.getElementById('reportContainer').innerHTML =
                    `<div style="text-align:center;padding:30px;color:#dc2626;"><i class="fas fa-exclamation-circle" style="font-size:32px;display:block;margin-bottom:10px;"></i>Error loading subject analysis.</div>`; }
