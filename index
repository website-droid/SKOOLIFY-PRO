                    });
                    const timeSlots = ['7:00-7:40', '7:40-8:20', '8:20-9:00', '9:00-9:40', '10:00-10:40',
                        '10:40-11:20', '11:20-12:00', '12:00-12:40', '13:40-14:20', '14:20-15:00'
                    ];
                    timeSlots.forEach(slot => {
                        html +=
                            `<div class="cell time">${slot}</div>`;
                        days.forEach(day => {
                            const entry = entries.find(t => t.day === day && t.start === slot.split(
                            '-')[0]);
                            html +=
                                `<div class="cell">${entry ? `<strong>${entry.subject}</strong><br><span style="font-size:9px;color:#64748b;">${entry.teacher}</span>` : ''}</div>`;
                        });
                    });
                    html += `</div>
                            <div style="margin-top:5px;">
                                ${entries.map((t,i) => `<span style="font-size:11px;background:#f1f5f9;padding:2px 10px;border-radius:12px;margin:2px;">${t.day} ${t.start}-${t.end}: ${t.subject} (${t.teacher}) <i class="fas fa-trash delete-icon" onclick="window.deleteTimetable(${timetables.indexOf(t)})" style="font-size:10px;"></i></span>`).join('')}
                            </div>`;
                }
                container.innerHTML = html;
            } catch (e) { console.error("Load timetables error:", e);
                showPermissionError('timetablesContainer', loadTimetables); }
        }

