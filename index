                });
                const container = document.getElementById('timetablesContainer');
                if (filtered.length === 0) {
                    container.innerHTML =
                        '<p style="color:#64748b;text-align:center;padding:20px;">No timetables found.</p>';
                    return;
                }
                const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'];
                let html = '';
                const grouped = {};
                filtered.forEach(t => {
                    const key = `${t.grade}_${t.stream}`;
                    if (!grouped[key]) grouped[key] = [];
                    grouped[key].push(t);
                });
                for (const [key, entries] of Object.entries(grouped)) {
                    const [grade, stream] = key.split('_');
                    html += `<div style="margin-bottom:20px;"><h4>${grade} - ${stream}</h4><div class="timetable-grid">`;
                    html +=
                        `<div class="cell header">Time</div>`;
