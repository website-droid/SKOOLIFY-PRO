        async function loadFirebaseDataWithRetry() {
            let attempts = 0;
            while (attempts < MAX_RETRIES) {
                try {
                    const result = await loadFirebaseDataOnce();
                    if (result) {
                        loadAttempts = 0;
                        dataLoaded = true;
                        return true;
                    }
                    return false;
                } catch (error) {
                    attempts++;
                    const isPermError = isPermissionError(error);
                    if (isPermError) {
                        console.error('⛔ Permission error loading data:', error);
                        showToast('⛔ You don\'t have permission to view this data. Please contact the school administrator.',
                            true);
                        return false;
                    }
                    if (attempts < MAX_RETRIES) {
                        console.warn(`⚠️ Load attempt ${attempts} failed. Retrying in ${RETRY_DELAY/1000}s...`, error);
                        showToast(`🔄 Retrying data load (${attempts}/${MAX_RETRIES})...`, false);
                        await new Promise(resolve => setTimeout(resolve, RETRY_DELAY));
                    } else {
                        console.error('❌ All load attempts failed:', error);
                        showToast('❌ Unable to load data. Please check your internet connection or contact admin.', true);
                        return false;
                    }
                }
            }
            return false;
        }

