                const filtered = students.filter(s => { if (stream === 'all') { return s.class === grade; } return s
                        .class === grade && s.stream === stream; });
                if (filtered.length === 0) {
                    container.innerHTML =
                        `<div style="text-align:center;padding:30px;color:#64748b;"><i class="fas fa-users" style="font-size:32px;display:block;margin-bottom:10px;"></i>No students found in ${grade} ${stream !== 'all' ? ' - ' + stream : ''}</div>`;
                    return;
                }
                const sorted = [...filtered].sort((a, b) => avg(b) - avg(a));
                const subs = getSubjects(grade);
                const classAvg = sorted.reduce((sum, s) => sum + avg(s), 0) / sorted.length;
                const passCount = sorted.filter(s => avg(s) >= 50).length;
                const passRate = (passCount / sorted.length * 100).toFixed(1);
                let html =
                    `<div class="summary-stats"><div><strong>Total Students:</strong> ${sorted.length}</div><div><strong>Class Average:</strong> ${classAvg.toFixed(1)}%</div><div><strong>Pass Rate (≥50%):</strong> ${passRate}%</div>${stream === 'all' ? `<div><strong>Streams:</strong> ${[...new Set(sorted.map(s => s.stream))].join(', ')}</div>` : ''}</div>
