        function showSubjectAnalysis() {
            try {
                const grade = document.getElementById('reportClass').value;
                const subs = getSubjects(grade);
                const container = document.getElementById('reportContainer');
                if (students.length === 0) {
                    container.innerHTML =
                        `<div style="text-align:center;padding:30px;color:#64748b;"><i class="fas fa-chart-bar" style="font-size:32px;display:block;margin-bottom:10px;"></i>No students available.</div>`;
                    return;
