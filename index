            let html =
                `<div class="table-wrapper"><table class="data-table"><thead><tr><th>Book</th><th>Student</th><th>Borrow Date</th><th>Due Date</th><th>Status</th><th>Actions</th></tr></thead><tbody>`;
            const sorted = [...borrowings].sort((a, b) => new Date(b.borrowDate) - new Date(a.borrowDate));
            sorted.forEach((b, i) => {
                const overdue = !b.returned && new Date(b.dueDate) < new Date();
                const status = b.returned ? '✅ Returned' : overdue ? '🔴 Overdue' : '🟡 Active';
                const statusClass = b.returned ? 'available' : overdue ? 'overdue' : 'borrowed';
                html += `<tr>
                    <td>${escapeHtml(b.bookTitle)}</td>
                    <td>${escapeHtml(b.studentName)}</td>
                    <td>${b.borrowDate}</td>
                    <td>${b.dueDate}</td>
