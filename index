                renderCurrentSheet();
                filterStudents();
                loadDashboard();
                closeModal('importModal');
                const skipped = importMatches.length - updatedCount;
                showToast(`✅ Marks imported for ${updatedCount} students! ${skipped} skipped.`, false);
