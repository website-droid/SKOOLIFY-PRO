                `<div class="analytics-enhanced"><h4>📊 Stream Performance</h4><div class="table-wrapper"><table class="data-table"><thead><tr><th>Stream</th><th>Students</th><th>Average</th><th>Pass Rate</th><th>Top Student</th></tr></thead><tbody>`;
            streams.forEach(stream => {
