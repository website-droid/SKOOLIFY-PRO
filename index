                    const att = getStudentAttendanceSummary(s.id);
                    const attDisplay = att ? `${att.rate}%` : 'N/A';
                    html +=
                        `<tr><td><strong>${index + 1}</strong></td><td><strong>${escapeHtml(s.name)}</strong></td><td>${s.stream}</td>${subs.map(sub => `<td>${getMark(s, sub)}</td>`).join('')}<td><strong>${totalScore}</strong></td><td><strong>${average.toFixed(1)}%</strong></td><td><span class="grade-badge" style="background:${level.color};">${level.code}</span></td><td>${attDisplay}</td></tr>`;
