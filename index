        window.handleFile = function(file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });
                    const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
                    const jsonData = XLSX.utils.sheet_to_json(firstSheet, { defval: '' });
                    if (jsonData.length === 0) { showStatus('The Excel file is empty.', '#dc2626'); return; }
                    importRows = jsonData;
                    importHeaders = Object.keys(jsonData[0]);
                    showStatus('✅ File loaded! Matching students...', '#166534');
                    importIdentifierCol = detectStudentIdentifier(importHeaders);
                    const grade = document.getElementById('marksClass').value;
                    const subjects = getSubjects(grade);
                    importSubjectMap = getSubjectMapping(importHeaders, subjects);
                    importMatches = matchStudentsToDatabase(importRows, importIdentifierCol, importSubjectMap);
                    renderImportPreview(importMatches, importRows, importSubjectMap);
                    document.getElementById('importPreviewContainer').style.display = 'block';
                    const matched = importMatches.filter(m => m.status === 'matched').length;
                    const statusDiv = document.getElementById('importStatus');
                    statusDiv.style.display = 'block';
                    statusDiv.innerHTML =
                        `<span style="color:#166534;">✅ ${matched} students matched. Review and confirm below.</span>`;
                } catch (err) {
                    console.error('Import error:', err);
                    showStatus('Error reading file: ' + err.message, '#dc2626');
                }
            };
            reader.readAsArrayBuffer(file);
        };

        function showStatus(msg, color) {
            const statusDiv = document.getElementById('importStatus');
            statusDiv.style.display = 'block';
            statusDiv.innerHTML = `<span style="color:${color};">${msg}</span>`;
        }

        window.detectStudentIdentifier = function(headers) {
            const keywords = ['student code', 'code', 'upi', 'student', 'name', 'learner'];
            for (let i = 0; i < headers.length; i++) {
                const h = headers[i].toLowerCase().trim();
                for (let kw of keywords) { if (h.includes(kw)) return i; }
            }
            return 0;
        };

        window.getSubjectMapping = function(headers, subjects) {
            const mapping = {
                "ENG": "English",
                "KISW": "Kiswahili",
                "MATH": "Mathematics",
                "INT SCI": "Integrated Science",
                "PRE TECH": "Pre-Technical Studies",
                "AGRIC": "Agriculture and Nutrition",
                "RE": "Religious Education",
                "SS": "Social Studies",
                "CA": "Creative Arts",
                "C/A": "Creative Arts",
                "SCI": "Science and Technology",
                "ENV": "Environmental Activities",
                "PSYCH": "Psychomotor Activities",
                "LANG": "Language Activities"
            };
            const result = {};
            const lowerSubjects = subjects.map(s => s.toLowerCase());
            for (let i = 0; i < headers.length; i++) {
                const header = headers[i].trim();
                const headerLower = header.toLowerCase();
                if (mapping[header.toUpperCase()]) {
                    const mapped = mapping[header.toUpperCase()];
                    if (lowerSubjects.includes(mapped.toLowerCase())) { result[i] = mapped; continue; }
                }
                for (let sub of subjects) {
                    if (headerLower === sub.toLowerCase() || headerLower.includes(sub.toLowerCase()) || sub
                        .toLowerCase().includes(headerLower)) { result[i] = sub; break; }
                }
            }
            return result;
        };

        window.matchStudentsToDatabase = function(rows, identifierCol, subjectMap) {
            const matches = [];
            for (let rowIndex = 0; rowIndex < rows.length; rowIndex++) {
                const row = rows[rowIndex];
                let identifier = '';
                if (identifierCol >= 0 && row[importHeaders[identifierCol]] !== undefined) {
                    identifier = String(row[importHeaders[identifierCol]]).trim();
                } else {
                    for (let key of Object.keys(row)) {
                        if (key.toLowerCase().includes('student') || key.toLowerCase().includes('name') || key
                            .toLowerCase().includes('code')) { identifier = String(row[key]).trim(); break; }
                    }
                }
                if (!identifier) { matches.push({ rowIndex, student: null, status: 'not_found', marks: {} });
                    continue; }
                let student = students.find(s => s.studentCode && s.studentCode.toLowerCase() === identifier
                .toLowerCase());
                if (!student) student = students.find(s => s.admNo && s.admNo.toLowerCase() === identifier
                .toLowerCase());
                if (!student) student = students.find(s => s.name && s.name.toLowerCase() === identifier
                .toLowerCase());
                if (!student && identifier.length > 3) {
                    const lowerId = identifier.toLowerCase();
                    student = students.find(s => s.name && s.name.toLowerCase().includes(lowerId));
                }
                const marks = {};
                for (let colIndex in subjectMap) {
                    const subject = subjectMap[colIndex];
                    const header = importHeaders[colIndex];
                    let value = parseFloat(row[header]);
                    if (isNaN(value)) {
                        value = row[header];
                        if (typeof value === 'string') {
                            const clean = value.replace(/[^0-9.]/g, '');
                            value = parseFloat(clean) || 0;
                        } else { value = 0; }
                    }
                    marks[subject] = Math.min(100, Math.max(0, value));
                }
                matches.push({ rowIndex, student: student || null, status: student ? 'matched' : 'not_found',
                    marks: marks });
            }
            return matches;
        };

        window.renderImportPreview = function(matches, rows, subjectMap) {
            const container = document.getElementById('importPreviewTable');
            const summary = document.getElementById('importSummary');
            const matchedCount = matches.filter(m => m.status === 'matched').length;
            const notFoundCount = matches.filter(m => m.status === 'not_found').length;
            summary.innerHTML =
                `<strong>${matchedCount}</strong> matched, <strong style="color:#f59e0b;">${notFoundCount}</strong> not found.`;
            document.getElementById('confirmImportBtn').disabled = (matchedCount === 0);
            const subjectCols = Object.values(subjectMap);
            const uniqueSubjects = [...new Set(subjectCols)];
            let html =
                `<table class="data-table"><thead><tr><th>#</th><th>Student Code</th><th>Student Name</th>`;
            uniqueSubjects.forEach(sub => { html += `<th>${sub}</th>`; });
            html += `<th>Status</th></tr></thead><tbody>`;
            for (let i = 0; i < matches.length; i++) {
