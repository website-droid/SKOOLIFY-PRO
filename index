                error.message && error.message.includes('Missing or insufficient permissions'));
        }

        function getWeekNumber(dateStr) {
            if (!settings.openingDate) return 1;
            const start = new Date(settings.openingDate);
            const d = new Date(dateStr);
            const diff = Math.floor((d - start) / (7 * 86400000));
            return Math.min(Math.max(diff + 1, 1), settings.weeksInTerm || 13);
        }

        function getTerm() { return `${settings.term || 'Term 2'}, ${settings.year || '2025'}`; }

