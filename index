        function exportClassSummaryToExcel() {
            try {
                const grade = document.getElementById('reportClass').value;
                const stream = document.getElementById('reportStream').value;
                const filtered = students.filter(s => { if (stream === 'all') { return s.class === grade; } return s
                        .class === grade && s.stream === stream; });
                if (filtered.length === 0) { showToast('No data to export.', true); return; }
                const sorted = [...filtered].sort((a, b) => avg(b) - avg(a));
                const subs = getSubjects(grade);
                const data = sorted.map((s, index) => {
                    const row = { 'Rank': index + 1, 'Name': s.name, 'Stream': s.stream,
                        'Student Code': s.studentCode, 'UPI': s.admNo, 'Parent Phone': s.parentPhone || '' };
                    subs.forEach(sub => { row[sub] = getMark(s, sub); });
                    const att = getStudentAttendanceSummary(s.id);
                    row['Attendance Rate'] = att ? `${att.rate}%` : 'N/A';
                    row['Total'] = total(s);
                    row['Average'] = parseFloat(avg(s).toFixed(1));
                    row['Level'] = getPerformanceLevel(avg(s)).code;
                    return row;
                });
                const ws = XLSX.utils.json_to_sheet(data);
                const wb = XLSX.utils.book_new();
                const sheetName = stream === 'all' ? `${grade}_All_Streams` : `${grade}_${stream}`;
                XLSX.utils.book_append_sheet(wb, ws, sheetName);
                XLSX.writeFile(wb, `Class_Summary_${grade}_${stream === 'all' ? 'All_Streams' : stream}.xlsx`);
                showToast(`✅ Excel file exported!`, false);
            } catch (e) { console.error("exportClassSummaryToExcel error:", e);
                showToast('Error exporting to Excel.', true); }
        }

