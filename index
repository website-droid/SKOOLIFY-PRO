                "Integrated Science": "INT SCI",
                "Pre-Technical Studies": "PRE TECH",
                "Agriculture and Nutrition": "AGR",
                "Religious Education": "RE",
                "Social Studies": "SS",
                "Creative Arts": "CA",
                "Science and Technology": "SCI",
                "Environmental Activities": "ENV",
                "Language Activities": "LANG",
                "Mathematical Activities": "MATH ACT",
                "Psychomotor Activities": "PSYCH"
            };
            return codeMap[subject] || subject.substring(0, 3).toUpperCase();
        }

        function getPaperDetails(subject) {
            const paperMap = {
                "English": { paper: "601", paperCode: "ENGLISH" },
                "Kiswahili": { paper: "602", paperCode: "KISWAHILI" },
                "Mathematics": { paper: "603", paperCode: "MATHEMATICS" },
                "Science and Technology": { paper: "604", paperCode: "SCIENCE" },
                "Social Studies": { paper: "605", paperCode: "SOCIAL STUDIES" },
                "Creative Arts": { paper: "606", paperCode: "CREATIVE ARTS" },
                "Religious Education": { paper: "607", paperCode: "RELIGIOUS ED" },
                "Agriculture and Nutrition": { paper: "608", paperCode: "AGRICULTURE" },
                "Environmental Activities": { paper: "609", paperCode: "ENVIRONMENTAL" },
                "Language Activities": { paper: "610", paperCode: "LANGUAGE" },
                "Mathematical Activities": { paper: "611", paperCode: "MATHEMATICAL" },
                "Psychomotor Activities": { paper: "612", paperCode: "PSYCHOMOTOR" }
            };
            return paperMap[subject] || { paper: "600", paperCode: subject.toUpperCase().replace(/ /g, '_') };
        }

        function getFullDescriptor(levelCode) {
            const map = {
                "EE1": "Exceeding Expectation",
                "EE2": "Very Good",
                "ME1": "Good",
                "ME2": "Fair / Satisfactory",
                "AE1": "Needs Improvement",
                "AE2": "Below Average",
                "BE1": "Well Below Average",
                "BE2": "Minimal / Poor Performance"
            };
            return map[levelCode] || levelCode;
        }

        function getTeacherForGrade(grade, stream) {
            const teacher = teachers.find(t => t.grade === grade && t.stream === stream);
            return teacher ? teacher.name : settings.teacher || 'Not Assigned';
        }

        function getStreamRank(student) {
            const streamStudents = students.filter(s => s.class === student.class && s.stream === student.stream);
            const sorted = [...streamStudents].sort((a, b) => avg(b) - avg(a));
            return sorted.indexOf(student) + 1;
        }

        function getClassRank(student) {
            const classStudents = students.filter(s => s.class === student.class);
            const sorted = [...classStudents].sort((a, b) => avg(b) - avg(a));
            return sorted.indexOf(student) + 1;
        }

