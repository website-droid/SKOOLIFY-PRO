        const subjectsMap = {
            prePrimary: ["Language Activities", "Mathematical Activities", "Environmental Activities",
                "Psychomotor Activities", "Religious Education"
            ],
            lowerPrimary: ["English", "Kiswahili", "Mathematics", "Environmental Activities", "Creative Arts",
                "Religious Education"
            ],
            upperPrimary: ["English", "Kiswahili", "Mathematics", "Agriculture and Nutrition", "Science and Technology",
                "Social Studies", "Religious Education", "Creative Arts"
            ],
            juniorSecondary: ["English", "Kiswahili", "Mathematics", "Integrated Science", "Pre-Technical Studies",
                "Agriculture and Nutrition", "Religious Education", "Social Studies", "Creative Arts"
            ]
        };

        function getSubjects(grade) {
            if (!grade) return [];
            if (grade === "PP1" || grade === "PP2") return subjectsMap.prePrimary;
            let n = parseInt(grade.split(" ")[1]);
            if (isNaN(n)) return subjectsMap.prePrimary;
            if (n <= 3) return subjectsMap.lowerPrimary;
            if (n <= 6) return subjectsMap.upperPrimary;
            return subjectsMap.juniorSecondary;
        }

        function avg(s) { if (!s.marks) return 0; let vals = Object.values(s.marks); if (vals.length === 0) return 0; return vals
                .reduce((a, b) => a + b, 0) / vals.length; }

        function getMark(s, area) { if (!s.marks) return 0; let key = area.toLowerCase().replace(/[^a-z]/g, ''); return s
                .marks[key] || 0; }

        function setMark(s, area, val) { let key = area.toLowerCase().replace(/[^a-z]/g, ''); if (!s.marks) s.marks = {}; s
                .marks[key] = val; }

        function total(student) { let subs = getSubjects(student.class); return subs.reduce((sum, sub) => sum + getMark(
                student, sub), 0); }

        const performanceLevels = {
            "EE1": { min: 90, max: 100, code: "EE1", points: 8, descriptor: "Exceptional / Excellent",
            color: "#0d9488" },
            "EE2": { min: 75, max: 89, code: "EE2", points: 7, descriptor: "Very Good", color: "#14b8a6" },
            "ME1": { min: 58, max: 74, code: "ME1", points: 6, descriptor: "Good", color: "#3b82f6" },
            "ME2": { min: 41, max: 57, code: "ME2", points: 5, descriptor: "Fair / Satisfactory", color: "#60a5fa" },
            "AE1": { min: 31, max: 40, code: "AE1", points: 4, descriptor: "Needs Improvement", color: "#f59e0b" },
            "AE2": { min: 21, max: 30, code: "AE2", points: 3, descriptor: "Below Average", color: "#fbbf24" },
            "BE1": { min: 11, max: 20, code: "BE1", points: 2, descriptor: "Well Below Average", color: "#ef4444" },
            "BE2": { min: 0, max: 10, code: "BE2", points: 1, descriptor: "Minimal / Poor Performance",
            color: "#dc2626" }
        };

        function getPerformanceLevel(score) {
            for (let [code, data] of Object.entries(performanceLevels)) {
                if (score >= data.min && score <= data.max) return { code, points: data.points, descriptor: data
                        .descriptor, color: data.color };
            }
            return { code: "BE2", points: 1, descriptor: "Minimal / Poor Performance", color: "#dc2626" };
        }

        function getStudentAttendanceSummary(studentId) {
            const records = attendanceRecords.filter(r => r.studentId === studentId);
            if (records.length === 0) return null;
            const present = records.filter(r => r.status === 'Present').length;
            const absent = records.filter(r => r.status === 'Absent').length;
            const excused = records.filter(r => r.status === 'Excused').length;
            const total = present + absent + excused;
            const rate = total > 0 ? ((present / total) * 100).toFixed(1) : 0;
            return { present, absent, excused, total, rate };
        }

