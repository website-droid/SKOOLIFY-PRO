        async function processBulkRegistration() {
            try {
                const validStudents = bulkStudents.filter(s => s.name && s.phone);
                if (validStudents.length === 0) { showToast("Add at least one student with name and phone", true); return; }
                let successCount = 0,
                    failedCount = 0;
                for (let s of validStudents) {
                    if (!s.name || !s.phone) { failedCount++; continue; }
                    try {
                        let code = genCode();
                        let newStudent = {
                            id: Date.now(),
                            admNo: `UPI${Date.now()}${Math.floor(Math.random()*1000)}`,
                            name: s.name,
                            class: s.class || "Grade 1",
                            stream: s.stream || (loadStreams()[0] || "North"),
                            parentPhone: s.phone,
                            studentCode: code,
                            marks: {},
                            regDate: new Date().toISOString(),
                            isBoarding: false,
                            parentId: null
                        };
                        let subjectsList = getSubjects(newStudent.class);
                        subjectsList.forEach(sub => setMark(newStudent, sub, 0));
                        students.push(newStudent);
                        successCount++;
                    } catch (e) { console.error("Error registering student:", s.name, e);
                        failedCount++; }
                }
                await saveToFirebase();
                await loadFromFirebase();
                refreshAllUI();
                showToast(`✅ ${successCount} students registered bulk! (${failedCount} failed)`, false);
                closeModal("bulkPaymentModal");
                bulkStudents = [];
                renderBulkList();
            } catch (e) { console.error("Process bulk registration error:", e);
                showToast("Error processing bulk registration", true); }
        }

