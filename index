                const userDoc = await db.collection('users').doc(currentUser.uid).get();
                if (userDoc.exists && userDoc.data().role) {
                    const role = userDoc.data().role;
                    if (role === 'superadmin' || role === 'admin') {
                        currentUserRole = role;
                    }
                }

                // Then check school data for role-specific users
                const doc = await db.collection('schools').doc(currentUser.uid).get();
                if (doc.exists) {
                    const data = doc.data();
                    const parent = (data.parents || []).find(p => p.email === email);
                    if (parent) currentUserRole = 'parent';
                    const teacher = (data.teachers || []).find(t => t.email === email);
                    if (teacher && currentUserRole !== 'parent') currentUserRole = 'teacher';
                    const staffMember = (data.staff || []).find(s => s.email === email);
                    if (staffMember && currentUserRole !== 'parent' && currentUserRole !== 'teacher') {
                        currentUserRole = staffMember.role.toLowerCase();
                    }
                }

                const loaded = await loadFromFirebase();
                if (loaded) {
                    document.getElementById('authSection').style.display = 'none';
                    document.getElementById('mainApp').style.display = 'block';
                    refreshAllUI();
                    showToast(`Welcome ${currentUserRole}!`, false);
