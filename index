                if (!markSheets[currentSheetIndex].data[sheetKey]) { markSheets[currentSheetIndex].data[sheetKey] = {}; }
                let updatedCount = 0;
                for (let match of matchedStudents) {
                    const student = match.student;
                    const marks = match.marks;
                    for (let subject in marks) {
                        if (marks[subject] !== undefined) { setMark(student, subject, marks[subject]); }
                    }
                    if (!markSheets[currentSheetIndex].data[sheetKey][student.id]) { markSheets[currentSheetIndex].data[
