        async function addStudent() {
            try {
                const name = document.getElementById("studentName").value.trim();
                const phone = document.getElementById("parentPhone").value.trim();
                const sClass = document.getElementById("studentClass").value;
                const stream = document.getElementById("studentStream").value;
                const upi = document.getElementById("upiInput").value.trim();
                const assessmentNo = document.getElementById("assessmentNoInput").value.trim();
                if (!name) { showToast("Enter student name", true); return; }
                if (!phone) { showToast("Enter parent phone", true); return; }
                if (!upi) { showToast("Enter UPI", true); return; }
                if (!assessmentNo) { showToast("Enter Student Code", true); return; }
                if (students.find(s => s.admNo === upi)) { showToast("UPI already exists!", true); return; }
                if (students.find(s => s.studentCode === assessmentNo)) { showToast("Student Code already exists!",
                    true); return; }
                let newStudent = {
                    id: Date.now(),
                    admNo: upi,
                    name: name,
                    class: sClass,
                    stream: stream,
                    parentPhone: phone,
                    studentCode: assessmentNo,
                    marks: {},
                    regDate: new Date().toISOString(),
                    isBoarding: false,
                    parentId: null
                };
                let subjectsList = getSubjects(sClass);
                subjectsList.forEach(sub => setMark(newStudent, sub, 0));
                students.push(newStudent);
                await saveToFirebase();
                await loadFromFirebase();
                refreshAllUI();
                showToast(`✅ ${name} registered! Code: ${assessmentNo}`, false);
                closeModal("studentModal");
            } catch (e) { console.error("Add student error:", e);
                showToast("Error adding student: " + e.message, true); }
        }

